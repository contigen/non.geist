{
  "name": "non.geist",
  "author": "contigen",
  "version": "2.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contigen/non.geist.git"
  },
  "main": "font-faces/sans-var.css",
  "types": "types/index.d.ts",
  "files": [
    "font-faces",
    "fonts",
    "types"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./font-faces/sans-var.css"
    },
    "./italic": {
      "types": "./types/index.d.ts",
      "default": "./font-faces/sans-var-italic.css"
    },
    "./mono": {
      "types": "./types/index.d.ts",
      "default": "./font-faces/mono-var.css"
    },
    "./mono-italic": {
      "types": "./types/index.d.ts",
      "default": "./font-faces/mono-var-italic.css"
    },
    "./pixel": {
      "types": "./types/index.d.ts",
      "default": "./font-faces/pixel-all.css"
    },
    "./pixel/circle": {
      "types": "./types/index.d.ts",
      "default": "./font-faces/GeistPixel-Circle.css"
    },
    "./pixel/grid": {
      "types": "./types/index.d.ts",
      "default": "./font-faces/GeistPixel-Grid.css"
    },
    "./pixel/line": {
      "types": "./types/index.d.ts",
      "default": "./font-faces/GeistPixel-Line.css"
    },
    "./pixel/square": {
      "types": "./types/index.d.ts",
      "default": "./font-faces/GeistPixel-Square.css"
    },
    "./pixel/triangle": {
      "types": "./types/index.d.ts",
      "default": "./font-faces/GeistPixel-Triangle.css"
    },
    "./font-faces/*": "./font-faces/*"
  },
  "scripts": {
    "generate": "bun scripts/index.ts"
  },
  "devDependencies": {
    "bun-types": "latest",
    "chokidar": "^3.6.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  },
  "description": "Vercel's Geist font for non-Next.js projects",
  "keywords": [
    "fonts",
    "typefaces",
    "web fonts",
    "vercel",
    "Geist",
    "Geist Sans",
    "Geist Mono",
    "Geist Pixel",
    "pixel fonts",
    "display fonts",
    "variable fonts"
  ],
  "license": "MIT",
  "bugs": "https://github.com/contigen/non.geist/issues"
}
