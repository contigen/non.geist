{
  "name": "non.geist",
  "author": "contigen",
  "version": "2.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contigen/non.geist.git"
  },
  "main": "font-faces/sans-var.css",
  "files": [
    "font-faces",
    "fonts"
  ],
  "exports": {
    ".": "./font-faces/sans-var.css",
    "./italic": "./font-faces/sans-var-italic.css",
    "./mono": "./font-faces/mono-var.css",
    "./mono-italic": "./font-faces/mono-var-italic.css",
    "./pixel": "./font-faces/pixel-all.css",
    "./pixel/circle": "./font-faces/GeistPixel-Circle.css",
    "./pixel/grid": "./font-faces/GeistPixel-Grid.css",
    "./pixel/line": "./font-faces/GeistPixel-Line.css",
    "./pixel/square": "./font-faces/GeistPixel-Square.css",
    "./pixel/triangle": "./font-faces/GeistPixel-Triangle.css",
    "./font-faces/": "./font-faces/"
  },
  "scripts": {
    "generate": "bun scripts/index.ts"
  },
  "devDependencies": {
    "bun-types": "latest",
    "chokidar": "^3.6.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
