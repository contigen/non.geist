  "description": "Vercel's Geist font for non-Next.js projects",
  "keywords": [
    "fonts",
    "typefaces",
    "web fonts",
    "vercel",
    "Geist",
    "Geist Sans",
    "Geist Mono",
    "Geist Pixel",
    "pixel fonts",
    "display fonts",
    "variable fonts"
